{
  "Keycloak": {
    "Realm": "apptemplate",
    "ClientId": "apptemplate-backend-for-frontend"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExternalIdentityProviders": {
    "google": {
      "DisplayName": "Google",
      "Enabled": false
    },
    "github": {
      "DisplayName": "GitHub",
      "Enabled": false
    },
    "microsoft": {
      "DisplayName": "Microsoft",
      "Enabled": false
    }
  }
}
