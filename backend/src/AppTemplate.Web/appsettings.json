{
  "DatabaseOptions": {
    "RecreateOnStartup": true
  },
  "Jwt": {
    "Issuer": "AppTemplate",
    "Audience": "AppTemplate",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
