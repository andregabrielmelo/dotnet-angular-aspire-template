{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AppTemplate;User Id=postgres;Password=postgres;",
    "apptemplate": "Server=localhost;Database=AppTemplate;User Id=postgres;Password=postgres;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Mailserver": {
    "Hostname": "localhost",
    "Port": 25
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "AppTemplate",
      "Audience": "AppTemplate",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 14
    },
    "Google": {
      "ClientId": ""
    },
    "Email": {
      "FromAddress": "noreply@apptemplate.local",
      "ConfirmationTokenLifetimeHours": 24,
      "ResetTokenLifetimeHours": 1
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  }
}
